#!/usr/bin/env bash
# Personal Claude Code entry. All paths derive from this file's real location.
set -e
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
AGENT_REPO="$(dirname "$(dirname "$SELF")")"
_PH="${PROFILE_HOME:-}"
[ -f "$AGENT_REPO/profile.env" ] && . "$AGENT_REPO/profile.env"
[ -n "$_PH" ] && PROFILE_HOME="$_PH"
BASE="${PROFILE_HOME:-$(dirname "$AGENT_REPO")}"
export AGENT_PROFILE_HOME="$BASE"

# 使用个人 Claude 配置
export CLAUDE_CONFIG_DIR="$BASE/claude"

# 避免自动更新影响共享用户的默认安装
export DISABLE_AUTOUPDATER=1

# 不继承可能属于共享账户的 Anthropic API 凭据
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN

# 个人 Git 身份与凭据隔离
. "$AGENT_REPO/env/git-agent-env.sh"

# AGENT_CLAUDE_BIN 仅用于测试(doctor)或自定义二进制
exec "${AGENT_CLAUDE_BIN:-$BASE/claude-home/.local/bin/claude}" "$@"
