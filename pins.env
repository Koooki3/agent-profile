# 版本钉死(只提供默认值,profile.env / 环境变量可覆盖)。升级是显式操作: 改这里 -> bootstrap.sh --sync
: "${CLAUDE_VERSION:=2.1.287}"
: "${CODEX_VERSION:=0.162.1}"
# skill-loom 仅在启用 skill-lifecycle 时才会被克隆;SKILL_LOOM_REPO 设为空可禁用,也可指向自己的 fork。
: "${SKILL_LOOM_REPO=https://github.com/Koooki3/skill-loom.git}"
: "${SKILL_LOOM_COMMIT:=34efa6e539e2d1da829d05652d6c0df1c1433a7a}"
